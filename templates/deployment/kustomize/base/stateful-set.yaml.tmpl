{{- if not .Deployment.Parameters.External }}
{{- /*
  Two shapes render here (deploymentTemplateParameters in builder.go):

  - Durable (restricted profiles, i.e. every deployed cell): `vault server`
    with integrated raft storage on a PersistentVolumeClaim, auto-unsealed by
    the seal the environment supplies (provision/server.sh). State — the
    transit keys every ciphertext and API-key HMAC depends on, and KV data —
    survives restarts, reschedules and rollouts.
  - Dev (the ephemeral local-apply profile): `vault server -dev`, in-memory,
    re-provisioned on every start, started by provision/dev.sh. Never a
    deployed shape: a restart loses every key it held, so that script refuses
    to start unless this render declares the local-apply context, and it keeps
    the dev banner's unseal key and root token out of the container's output.
*/}}
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{.Name}}
  namespace: {{.Namespace}}
spec:
  serviceName: {{.Name}}
  # One raft node. Scaling out needs retry_join and TLS between the peers;
  # nothing else in this render supports more than one replica.
  replicas: 1
  selector:
    matchLabels:
      app: {{.Name}}
{{- if .Deployment.Parameters.Durable }}
  # Deleting or scaling the StatefulSet never deletes the data volume: it
  # holds the only copy of the transit keys.
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
{{- end }}
  template:
    metadata:
      labels:
        app: {{.Name}}
    spec:
      automountServiceAccountToken: false
      # uid 100 = `vault` user in the image. fsGroup makes the data volume
      # writable by it.
      securityContext:
        runAsNonRoot: true
        runAsUser: 100
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      containers:
        - name: vault
          # Supplied by main.go's image declaration, including its digest.
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 100
            # mlock stays disabled (disable_mlock with raft, as HashiCorp
            # recommends for integrated storage; dev mode never mlocks), so
            # IPC_LOCK is not needed and every capability is dropped.
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
{{- if .Deployment.Parameters.Durable }}
          command: {{ .Deployment.Parameters.ServerCommand }}
{{- else }}
          # provision/dev.sh: refuses to start unless VAULT_CODEFLY_RENDER_PROFILE
          # below declares the local-apply context, mints the in-memory server's
          # own bootstrap root token into the container's tmpfs, and starts
          # `vault server -dev` with its banner — which carries that token and
          # the unseal key — kept out of the container's output.
          command: {{ .Deployment.Parameters.DevCommand }}
{{- end }}
          ports:
            - name: http
              containerPort: 8200
          env:
{{- if .Deployment.Parameters.Durable }}
            # Opts this container into the environment's per-service
            # configuration: the seal (VAULT_SEAL_TYPE and that seal's own
            # variables) and, optionally, VAULT_RECOVERY_PGP_KEY arrive here as
            # environment variables. None of it is part of this render.
            - name: CODEFLY__SERVICE
              value: {{ .Deployment.Parameters.ServiceName | printf "%q" }}
{{- end }}
{{- if .Deployment.Parameters.RenderProfile }}
            # The context provision/dev.sh demands before it will start an
            # in-memory store. Only this render declares it.
            - name: VAULT_CODEFLY_RENDER_PROFILE
              value: {{ .Deployment.Parameters.RenderProfile | printf "%q" }}
{{- end }}
{{- if not .Restricted }}
{{- range $secretKey, $_ := .SecretMap }}
            # The token consumers present. It is not the server's own root
            # token in either render: the postStart hook installs it as an
            # orphan carrying only the consumer policy.
            - name: VAULT_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{$.Name}}-secret
                  key: {{ $secretKey }}
{{- end }}
{{- else }}
{{- range $environmentVariable, $reference := .SecretReferences }}
            - name: {{ $environmentVariable }}
              valueFrom:
                secretKeyRef:
                  name: {{ $reference.Name }}
                  key: {{ $reference.Key }}
                  optional: {{ $reference.Optional }}
{{- end }}
{{- end }}
{{- if .Deployment.Parameters.ProvisionCommand }}
{{- if .Deployment.Parameters.Durable }}
          # Initializes the server once, makes sure KV v2 at secret/ and the
          # transit engine and key exist, and installs the composition-supplied
          # access token as an orphan carrying only the consumer policy
          # (provision/provision.sh, durable mode). It runs on every start and
          # is idempotent: existing state, above all an existing transit key, is
          # never rewritten. The container does not reach Running until it
          # succeeds; a failed hook restarts the container.
{{- else }}
          # Consumers encrypt and HMAC through transit/ (the configured key), and
          # `vault server -dev` starts with no transit engine. The hook
          # provisions it over loopback and installs the access token under the
          # consumer policy (provision/provision.sh, dev mode) on every
          # container start, because the dev store is in-memory. A restart
          # therefore mints a NEW key: everything encrypted or HMACed before it
          # is unreadable. That is acceptable only for this disposable local
          # render.
{{- end }}
          lifecycle:
            postStart:
              exec:
                command: {{ .Deployment.Parameters.ProvisionCommand }}
{{- end }}
          resources:
            requests:
              cpu: 50m
{{- if .Deployment.Parameters.Durable }}
              memory: 128Mi
{{- else }}
              memory: 64Mi
{{- end }}
            limits:
              cpu: 500m
{{- if .Deployment.Parameters.Durable }}
              memory: 512Mi
{{- else }}
              memory: 256Mi
{{- end }}
          # Vault's /v1/sys/health returns:
          #   200 — initialized, unsealed, active
          #   429 — unsealed and standby (multi-node)
          #   501 — not initialized
          #   503 — sealed
          # Startup and liveness only ask whether the process answers: a
          # durable server is uninitialized until its first postStart hook
          # completes, and sealed while its seal is unreachable — restarting it
          # fixes neither. Readiness is strict: only an initialized, unsealed,
          # active server receives traffic.
          startupProbe:
            httpGet:
              path: /v1/sys/health?standbyok=true&sealedok=true&uninitcode=200
              port: 8200
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /v1/sys/health
              port: 8200
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
{{- if .Deployment.Parameters.Durable }}
              path: /v1/sys/health?standbyok=true&sealedok=true&uninitcode=200
{{- else }}
              path: /v1/sys/health?standbyok=true
{{- end }}
              port: 8200
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          # readOnlyRootFilesystem: every write goes to an explicit mount.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: home
              mountPath: /home/vault
{{- if .Deployment.Parameters.Durable }}
            - name: data
              mountPath: /vault/data
{{- end }}
      volumes:
        - name: tmp
          emptyDir: {}
        - name: home
          emptyDir: {}
{{- if .Deployment.Parameters.Durable }}
  # raft storage and the init record (recovery key material). The claim uses the
  # cluster's default StorageClass; the environment owns that choice, including
  # its reclaim policy and snapshots.
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 1Gi
{{- end }}
{{- end }}
